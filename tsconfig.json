{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": ".build",
    "rootDir": "."
  },
  "include": ["db/**/*.ts", "netlify/functions/**/*.ts"],
  "exclude": ["node_modules"]
}
